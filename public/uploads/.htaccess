# Carpeta de imágenes subidas desde el panel: solo se sirven imágenes, nunca código.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "^(?!.*\.(jpe?g|png|webp|gif)$).*$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
